@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
  --ink: #22261f;
  --muted: #696e63;
  --paper: #f5f4ee;
  --white: #fffefa;
  --olive: #59634b;
  --olive-dark: #343c30;
  --line: #dcded4;
  --serif: Georgia, 'Times New Roman', serif;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: 'DM Sans', Arial, sans-serif;
  font-size: 16px;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
}
a { color: inherit; text-decoration: none; }
button, input, textarea, select { font: inherit; }
.container { width: min(1240px, calc(100% - 96px)); margin-inline: auto; }
.section-pad { padding-top: 112px; padding-bottom: 112px; }
h1, h2, h3, p { margin-top: 0; }
h1, h2, h3 { font-family: 'Manrope', Arial, sans-serif; }
h2 { margin-bottom: 24px; font-size: clamp(2.4rem, 4vw, 4.2rem); line-height: 1.1; letter-spacing: -.055em; font-weight: 600; }
h2 em, h1 em { font-family: var(--serif); font-weight: 400; }
p { color: var(--muted); }
.eyebrow { margin-bottom: 18px; color: var(--olive); font-size: .7rem; font-weight: 700; letter-spacing: .17em; line-height: 1.5; }
.eyebrow.light { color: #e5e8da; }
.text-link { display: inline-flex; align-items: center; gap: 14px; padding-bottom: 5px; border-bottom: 1px solid #9a9f91; font-size: .87rem; font-weight: 700; transition: gap .2s, color .2s; }
.text-link:hover { gap: 20px; color: var(--olive); }
.light-link { color: white; border-color: #aab0a4; }
.light-link:hover { color: white; }
.button { display: inline-flex; align-items: center; justify-content: center; gap: 25px; min-height: 54px; padding: 0 23px; font-size: .83rem; font-weight: 700; transition: background .2s, color .2s; }
.button span { font-size: 1.05rem; }
.button-light { background: var(--white); color: var(--ink); }
.button-light:hover { background: #e5e6dc; }
.button-dark { background: var(--olive-dark); color: white; }
.button-dark:hover { background: #4f5a45; }
.fine-print { margin: 25px 0 0; font-size: .75rem; }

/* Header */
.site-header { position: absolute; z-index: 20; top: 0; left: 0; width: 100%; color: white; border-bottom: 1px solid rgb(255 255 255 / 20%); }
.header-inner { width: min(1360px, calc(100% - 72px)); min-height: 94px; margin: auto; display: flex; align-items: center; justify-content: space-between; gap: 26px; }
.brand { display: inline-flex; align-items: center; gap: 11px; flex-shrink: 0; }
.brand-mark { display: grid; place-items: center; width: 39px; height: 39px; border: 1px solid rgb(255 255 255 / 75%); font-family: var(--serif); font-size: 1.7rem; line-height: 1; }
.brand-name { display: flex; flex-direction: column; font-size: .68rem; font-weight: 700; letter-spacing: .13em; line-height: 1.5; }
.brand-name strong { font-size: .78rem; letter-spacing: .2em; }
.main-nav { display: flex; align-items: center; gap: clamp(15px, 1.8vw, 29px); }
.main-nav > a, .nav-dropdown > a { display: inline-flex; align-items: center; gap: 6px; min-height: 94px; font-size: .77rem; font-weight: 600; white-space: nowrap; }
.main-nav > a:hover, .nav-dropdown > a:hover { color: #e1e6d5; }
.nav-dropdown { position: relative; }
.dropdown-menu { position: absolute; top: calc(100% - 9px); left: -18px; display: none; min-width: 235px; padding: 12px 0; background: var(--white); color: var(--ink); box-shadow: 0 18px 35px rgb(0 0 0 / 14%); }
.nav-dropdown:hover .dropdown-menu, .nav-dropdown:focus-within .dropdown-menu { display: block; }
.dropdown-menu a { display: block; padding: 9px 18px; font-size: .82rem; }
.dropdown-menu a:hover { background: #eceee5; }
.header-cta { display: inline-flex; align-items: center; gap: 15px; padding: 13px 16px; border: 1px solid rgb(255 255 255 / 65%); font-size: .76rem; font-weight: 700; white-space: nowrap; }
.header-cta:hover { background: white; color: var(--ink); }
.mobile-menu { display: none; }

/* Hero */
.hero { position: relative; display: flex; align-items: center; min-height: 790px; height: min(900px, 100svh); max-height: 1000px; overflow: hidden; color: white; background: #4b5145; }
.hero-image, .hero-overlay { position: absolute; inset: 0; }
.hero-image { background: url('https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=2400&q=90') center 53% / cover no-repeat; transform: scale(1.02); }
.hero-overlay { background: linear-gradient(90deg, rgb(19 24 19 / 75%) 0%, rgb(24 29 22 / 53%) 48%, rgb(25 28 23 / 12%) 100%), linear-gradient(0deg, rgb(20 25 19 / 30%), transparent 48%); }
.hero-content { position: relative; z-index: 2; padding-top: 100px; }
.hero h1 { max-width: 850px; margin-bottom: 25px; font-size: clamp(3.8rem, 8vw, 7.8rem); line-height: .99; letter-spacing: -.075em; font-weight: 600; }
.hero h1 em { color: #e4e7d8; }
.hero-description { max-width: 570px; margin-bottom: 30px; color: rgb(255 255 255 / 86%); font-size: 1.04rem; line-height: 1.85; }
.hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 27px; }
.hero-note { display: flex; align-items: center; gap: 13px; margin-top: 76px; color: rgb(255 255 255 / 75%); font-size: .64rem; font-weight: 600; letter-spacing: .13em; }
.hero-note-line { width: 42px; height: 1px; background: #d6dacb; }
.hero-index { position: absolute; right: 48px; bottom: 35px; z-index: 2; color: rgb(255 255 255 / 72%); font-size: .68rem; letter-spacing: .12em; }
.hero-index span { color: white; }

/* Intro */
.intro { display: grid; grid-template-columns: .9fr 1.1fr; column-gap: 90px; row-gap: 75px; align-items: center; }
.intro-copy { max-width: 500px; }
.intro-copy h2 { max-width: 490px; }
.intro-copy > p:not(.eyebrow) { font-size: .95rem; line-height: 1.9; }
.intro-copy .text-link { margin-top: 14px; }
.intro-visual { position: relative; padding: 0 25px 28px 0; }
.intro-photo { min-height: 470px; background: url('https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&w=1300&q=85') center / cover; }
.photo-caption { display: flex; justify-content: space-between; padding-top: 13px; color: var(--muted); font-size: .62rem; letter-spacing: .12em; }
.round-stamp { position: absolute; right: 0; bottom: 75px; display: grid; place-content: center; width: 122px; height: 122px; border-radius: 50%; background: var(--olive); color: white; text-align: center; font-size: .62rem; line-height: 1.6; letter-spacing: .1em; transform: rotate(8deg); }
.round-stamp span { font-size: 1.2rem; }
.benefits-grid { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); }
.benefits-grid > div { padding: 26px 23px 0 0; }
.benefits-grid > div + div { padding-left: 23px; border-left: 1px solid var(--line); }
.benefits-grid span, .planning-grid article > span { color: var(--olive); font-size: .7rem; font-weight: 700; }
.benefits-grid h3 { margin: 13px 0 8px; font-size: 1.05rem; letter-spacing: -.03em; }
.benefits-grid p { margin-bottom: 0; font-size: .83rem; }

/* Tours */
.tours-section { background: #e9e9df; }
.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 35px; margin-bottom: 22px; }
.section-heading h2 { margin-bottom: 0; }
.section-heading > .text-link { margin-bottom: 9px; flex-shrink: 0; }
.section-lead { max-width: 660px; margin-bottom: 40px; font-size: .95rem; }
.tour-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 25px; }
.tour-card { background: var(--white); }
.tour-image { position: relative; display: block; aspect-ratio: 1.15 / 1; background-position: center; background-size: cover; overflow: hidden; }
.tour-image::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgb(0 0 0 / 25%), transparent 50%); transition: background .2s; }
.tour-image:hover::after { background: rgb(0 0 0 / 10%); }
.tour-number, .image-arrow { position: absolute; z-index: 1; top: 17px; display: grid; place-items: center; width: 38px; height: 38px; color: white; border: 1px solid rgb(255 255 255 / 70%); font-size: .7rem; }
.tour-number { left: 17px; }
.image-arrow { right: 17px; font-size: 1rem; }
.tour-card-content { padding: 27px 25px 28px; }
.tour-card-content .eyebrow { margin-bottom: 10px; font-size: .65rem; }
.tour-card h3 { margin-bottom: 12px; font-size: 1.35rem; line-height: 1.3; letter-spacing: -.04em; }
.tour-card-content > p:not(.eyebrow) { min-height: 78px; font-size: .86rem; }
.tour-meta { display: flex; gap: 20px; padding: 15px 0; margin-bottom: 18px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); color: var(--muted); font-size: .72rem; }

/* Destinations */
.destinations-section .section-heading { margin-bottom: 40px; }
.heading-aside { max-width: 370px; margin: 0 0 5px; font-size: .9rem; }
.destination-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; grid-template-rows: 265px 265px; gap: 15px; }
.destination-card { position: relative; display: flex; flex-direction: column; justify-content: space-between; min-width: 0; padding: 20px; color: white; background-position: center; background-size: cover; overflow: hidden; }
.destination-card::before { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgb(16 22 16 / 82%), rgb(16 22 16 / 4%) 78%); transition: background .25s; }
.destination-card:hover::before { background: linear-gradient(0deg, rgb(16 22 16 / 90%), rgb(16 22 16 / 10%) 100%); }
.destination-1 { grid-column: span 2; }
.destination-number, .destination-info { position: relative; z-index: 1; }
.destination-number { font-size: .68rem; letter-spacing: .1em; }
.destination-info h3 { margin-bottom: 5px; color: white; font-size: 1.45rem; letter-spacing: -.04em; }
.destination-info p { max-width: 430px; margin-bottom: 10px; color: rgb(255 255 255 / 82%); font-size: .81rem; }
.destination-link { font-size: .74rem; font-weight: 700; }
.destination-footer { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 25px; }
.destination-footer p { margin: 0; font-size: .78rem; }

/* Experiences */
.experiences-section { background: var(--olive-dark); color: white; }
.experiences-layout { display: grid; grid-template-columns: .8fr 1.2fr; gap: 100px; }
.experiences-heading h2 { max-width: 450px; }
.experiences-heading > p:not(.eyebrow) { margin-bottom: 28px; color: #d1d5c9; font-size: .92rem; }
.experience-list { border-top: 1px solid rgb(255 255 255 / 25%); }
.experience-row { display: grid; grid-template-columns: 35px 1fr 25px; gap: 16px; align-items: center; padding: 17px 0; border-bottom: 1px solid rgb(255 255 255 / 25%); }
.experience-number { align-self: start; padding-top: 4px; color: #c5cbb8; font-size: .67rem; }
.experience-copy { display: flex; flex-direction: column; gap: 4px; }
.experience-copy strong { font-size: .98rem; font-weight: 600; }
.experience-copy small { color: #c7cdbf; font-size: .79rem; line-height: 1.6; }
.experience-arrow { justify-self: end; transition: transform .2s; }
.experience-row:hover .experience-arrow { transform: translate(3px, -3px); }

/* Marrakech */
.marrakech-section { display: grid; grid-template-columns: 1fr 1fr; background: #e9e9df; }
.marrakech-image { min-height: 620px; background: url('https://images.unsplash.com/photo-1539020140153-e479b8c22e70?auto=format&fit=crop&w=1400&q=85') center / cover; }
.marrakech-copy { align-self: center; max-width: 650px; padding: 85px clamp(40px, 7vw, 110px); }
.marrakech-copy h2 { font-size: clamp(2.4rem, 3.7vw, 3.8rem); }
.marrakech-copy > p:not(.eyebrow) { font-size: .9rem; line-height: 1.9; }
.check-list { display: grid; gap: 8px; padding: 0; margin: 25px 0 30px; list-style: none; color: var(--ink); font-size: .84rem; }
.check-list li::before { content: '↗'; margin-right: 12px; color: var(--olive); }

/* Planning */
.planning-section .section-heading { margin-bottom: 55px; }
.planning-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
.planning-grid article { padding: 0 26px; border-left: 1px solid var(--line); }
.planning-grid article:first-child { padding-left: 0; border-left: 0; }
.planning-grid h3 { margin: 20px 0 10px; font-size: 1.15rem; line-height: 1.35; }
.planning-grid p { margin-bottom: 0; font-size: .84rem; }

/* Seasons */
.season-section { background: #e7e8de; }
.season-layout { display: grid; grid-template-columns: .85fr 1.15fr; gap: 100px; }
.season-copy > p:not(.eyebrow) { font-size: .9rem; line-height: 1.9; }
.season-copy .text-link { margin-top: 12px; }
.season-facts { display: grid; grid-template-columns: 1fr 1fr; }
.season-facts > div { padding: 23px; border-top: 1px solid #cbd0c3; }
.season-facts > div:nth-child(odd) { border-right: 1px solid #cbd0c3; }
.season-facts span { color: var(--olive); font-size: .65rem; font-weight: 700; letter-spacing: .15em; }
.season-facts h3 { margin: 12px 0 7px; font-size: 1.12rem; }
.season-facts p { margin-bottom: 0; font-size: .82rem; }

/* Culture */
.culture-section { display: grid; grid-template-columns: 1fr 1fr; gap: 95px; align-items: center; }
.culture-image { min-height: 500px; background: url('https://images.unsplash.com/photo-1489749798305-4fea3ae63d43?auto=format&fit=crop&w=1300&q=85') center / cover; }
.culture-copy > p:not(.eyebrow) { font-size: .92rem; line-height: 1.9; }
.culture-copy .text-link { margin-top: 13px; }

/* Journal */
.journal-section { border-top: 1px solid var(--line); }
.journal-section .section-heading { margin-bottom: 20px; }
.journal-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 25px; margin-top: 43px; }
.journal-image { display: block; aspect-ratio: 1.4 / 1; margin-bottom: 22px; background-position: center; background-size: cover; }
.journal-image-one { background-image: url('https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1000&q=85'); }
.journal-image-two { background-image: url('https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1000&q=85'); }
.journal-image-three { background-image: url('https://images.unsplash.com/photo-1544191696-15693072a9c7?auto=format&fit=crop&w=1000&q=85'); }
.journal-card .eyebrow { margin-bottom: 10px; font-size: .63rem; }
.journal-card h3 { margin-bottom: 10px; font-size: 1.3rem; line-height: 1.35; letter-spacing: -.035em; }
.journal-card > p:not(.eyebrow) { font-size: .84rem; }
.journal-card .text-link { margin-top: 5px; }

/* FAQ */
.faq-section { background: #e9e9df; }
.faq-layout { display: grid; grid-template-columns: .75fr 1.25fr; gap: 100px; }
.faq-intro > p:not(.eyebrow) { max-width: 340px; font-size: .9rem; }
.faq-intro .text-link { margin-top: 12px; }
.faq-list { border-top: 1px solid #cdd0c5; }
.faq-list details { border-bottom: 1px solid #cdd0c5; }
.faq-list summary { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 21px 0; cursor: pointer; list-style: none; font-size: .98rem; font-weight: 600; }
.faq-list summary::-webkit-details-marker { display: none; }
.faq-list summary span { font-size: 1.3rem; font-weight: 400; }
.faq-list details[open] summary span { transform: rotate(45deg); }
.faq-list details > p { max-width: 680px; padding: 0 30px 20px 0; margin-bottom: 0; font-size: .87rem; line-height: 1.85; }

/* Final CTA */
.final-cta { position: relative; display: grid; place-items: center; min-height: 500px; padding: 80px 0; overflow: hidden; color: white; text-align: center; }
.final-cta-image, .final-cta-overlay { position: absolute; inset: 0; }
.final-cta-image { background: url('https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=2200&q=85') center 55% / cover; }
.final-cta-overlay { background: rgb(27 33 25 / 65%); }
.final-cta-content { position: relative; z-index: 1; }
.final-cta h2 { margin-bottom: 17px; font-size: clamp(3rem, 6vw, 5.8rem); }
.final-cta-content > p:not(.eyebrow) { max-width: 580px; margin: 0 auto 28px; color: rgb(255 255 255 / 84%); }
.final-cta .button { margin: auto; }

/* Footer */
.site-footer { padding-top: 65px; background: #262d24; color: white; }
.footer-main { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 55px; padding-bottom: 55px; }
.brand-footer .brand-mark { border-color: #c7cebd; }
.footer-brand > p { max-width: 300px; margin-top: 23px; color: #c6cbbf; font-size: .83rem; }
.footer-column { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
.footer-column h3 { margin: 5px 0 12px; color: #c5cbb9; font-size: .67rem; letter-spacing: .15em; }
.footer-column a { color: #e0e3da; font-size: .81rem; }
.footer-column a:hover, .footer-bottom a:hover { color: white; text-decoration: underline; }
.footer-bottom { display: flex; justify-content: space-between; gap: 20px; padding-top: 19px; padding-bottom: 22px; border-top: 1px solid rgb(255 255 255 / 18%); color: #c4c9bc; font-size: .7rem; }

/* Responsive */
@media (max-width: 1100px) {
  .container { width: calc(100% - 64px); }
  .header-inner { width: calc(100% - 48px); }
  .main-nav { gap: 13px; }
  .main-nav > a, .nav-dropdown > a { font-size: .7rem; }
  .brand-name { font-size: .58rem; }
  .brand-name strong { font-size: .68rem; }
  .header-cta { padding: 11px; font-size: .7rem; }
  .intro { column-gap: 50px; }
  .experiences-layout, .season-layout, .faq-layout { gap: 55px; }
  .culture-section { gap: 55px; }
  .marrakech-copy { padding-inline: 45px; }
}
@media (max-width: 850px) {
  .section-pad { padding-top: 78px; padding-bottom: 78px; }
  .main-nav, .header-cta { display: none; }
  .header-inner { min-height: 78px; }
  .mobile-menu { display: block; position: relative; }
  .mobile-menu summary { list-style: none; cursor: pointer; font-size: 1.6rem; }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .mobile-menu nav { position: absolute; top: 45px; right: 0; display: grid; gap: 0; width: min(310px, calc(100vw - 48px)); padding: 12px; background: var(--white); color: var(--ink); box-shadow: 0 15px 30px rgb(0 0 0 / 20%); }
  .mobile-menu nav a { padding: 10px 12px; font-size: .9rem; }
  .mobile-menu nav a:hover { background: #eceee5; }
  .hero { min-height: 700px; height: 90svh; }
  .hero h1 { font-size: clamp(3.4rem, 10vw, 6rem); }
  .intro { grid-template-columns: 1fr 1fr; column-gap: 35px; }
  .intro-photo { min-height: 390px; }
  .benefits-grid { grid-template-columns: 1fr 1fr; row-gap: 25px; }
  .benefits-grid > div:nth-child(3) { padding-left: 0; border-left: 0; }
  .tour-grid { gap: 15px; }
  .tour-card-content { padding: 20px 17px; }
  .tour-card h3 { font-size: 1.12rem; }
  .destination-grid { grid-template-rows: 230px 230px; }
  .experiences-layout, .season-layout, .faq-layout { grid-template-columns: 1fr; gap: 45px; }
  .experiences-heading { max-width: 570px; }
  .marrakech-image { min-height: 500px; }
  .marrakech-copy { padding: 55px 35px; }
  .planning-grid { grid-template-columns: 1fr 1fr; row-gap: 35px; }
  .planning-grid article:nth-child(3) { padding-left: 0; border-left: 0; }
  .culture-section { gap: 35px; }
  .culture-image { min-height: 430px; }
  .footer-main { grid-template-columns: 1.3fr 1fr 1fr; gap: 35px; }
  .footer-brand { grid-column: 1 / -1; }
}
@media (max-width: 600px) {
  body { font-size: 15px; }
  .container { width: calc(100% - 40px); }
  .section-pad { padding-top: 65px; padding-bottom: 65px; }
  h2 { font-size: clamp(2.35rem, 10vw, 3.4rem); }
  .header-inner { width: calc(100% - 36px); }
  .brand-mark { width: 35px; height: 35px; }
  .hero { min-height: 720px; height: 92svh; max-height: 900px; align-items: center; }
  .hero-image { background-position: 58% center; }
  .hero-overlay { background: linear-gradient(90deg, rgb(19 24 19 / 75%), rgb(24 29 22 / 38%)), linear-gradient(0deg, rgb(20 25 19 / 30%), transparent 60%); }
  .hero-content { padding-top: 90px; }
  .hero h1 { font-size: clamp(3.3rem, 13vw, 5rem); }
  .hero-description { font-size: .95rem; }
  .hero-actions { align-items: flex-start; flex-direction: column; gap: 18px; }
  .hero-note { margin-top: 48px; font-size: .56rem; }
  .hero-index { right: 20px; bottom: 20px; font-size: .58rem; }
  .intro { grid-template-columns: 1fr; row-gap: 35px; }
  .intro-visual { grid-row: 2; }
  .intro-photo { min-height: 370px; }
  .round-stamp { width: 100px; height: 100px; font-size: .55rem; }
  .benefits-grid { grid-column: auto; grid-template-columns: 1fr 1fr; row-gap: 25px; }
  .benefits-grid > div { padding-right: 12px; }
  .benefits-grid > div + div { padding-left: 13px; }
  .benefits-grid > div:nth-child(3) { padding-left: 0; }
  .benefits-grid h3 { font-size: .98rem; }
  .benefits-grid p { font-size: .78rem; }
  .section-heading { align-items: flex-start; flex-direction: column; gap: 20px; }
  .section-heading > .text-link { margin-bottom: 0; }
  .section-lead { font-size: .88rem; }
  .tour-grid { grid-template-columns: 1fr; gap: 23px; }
  .tour-image { aspect-ratio: 1.25 / 1; }
  .tour-card-content > p:not(.eyebrow) { min-height: auto; }
  .destination-grid { grid-template-columns: 1fr 1fr; grid-template-rows: 245px 245px 245px; gap: 10px; }
  .destination-1 { grid-column: span 2; }
  .destination-card { padding: 13px; }
  .destination-info h3 { font-size: 1.08rem; }
  .destination-info p { font-size: .73rem; line-height: 1.5; }
  .destination-link { font-size: .68rem; }
  .destination-footer { align-items: flex-start; flex-direction: column; }
  .destination-footer p { font-size: .72rem; }
  .experience-row { grid-template-columns: 25px 1fr 20px; gap: 10px; }
  .experience-copy strong { font-size: .91rem; }
  .experience-copy small { font-size: .75rem; }
  .marrakech-section { grid-template-columns: 1fr; }
  .marrakech-image { min-height: 350px; }
  .marrakech-copy { padding: 55px 25px 60px; }
  .planning-grid { grid-template-columns: 1fr 1fr; gap: 28px 14px; }
  .planning-grid article { padding: 0 0 0 15px; }
  .planning-grid article:nth-child(odd) { padding-left: 0; border-left: 0; }
  .planning-grid h3 { font-size: 1rem; }
  .planning-grid p { font-size: .79rem; }
  .season-facts > div { padding: 18px 12px; }
  .season-facts h3 { font-size: .98rem; }
  .season-facts p { font-size: .77rem; }
  .culture-section { grid-template-columns: 1fr; gap: 35px; }
  .culture-image { min-height: 360px; }
  .journal-grid { grid-template-columns: 1fr; gap: 35px; }
  .journal-image { aspect-ratio: 1.4 / 1; }
  .faq-list summary { font-size: .9rem; }
  .final-cta { min-height: 460px; }
  .final-cta h2 { font-size: clamp(3rem, 12vw, 4.5rem); }
  .final-cta-content > p:not(.eyebrow) { font-size: .9rem; }
  .footer-main { grid-template-columns: 1fr 1fr; gap: 35px 20px; }
  .footer-brand { grid-column: 1 / -1; }
  .footer-bottom { flex-wrap: wrap; font-size: .65rem; }
}
