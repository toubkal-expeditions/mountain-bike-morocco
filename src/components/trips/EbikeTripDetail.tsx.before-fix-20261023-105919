function bookingHref(tour: EbikeTrip, request: "details" | "booking" = "details") {
  return `/contact?tour=${encodeURIComponent(tour.title)}&destination=${encodeURIComponent(tour.region)}&request=${request}`;
}

function getRouteStyle(tour: EbikeTrip) {
  const text = `${tour.title} ${tour.label} ${tour.region}`.toLowerCase();
  if (text.includes("day tour")) return "Guided electric-assisted day ride";
  if (text.includes("family")) return "Family-friendly E-MTB routes, matched to riders";
  if (text.includes("luxury")) return "Comfort-focused electric mountain biking";
  if (text.includes("desert") || text.includes("south morocco") || text.includes("agafay")) return "Open-country and desert-edge E-MTB routes";
  if (text.includes("coast") || text.includes("atlantic")) return "Point-to-point mountain and coastal riding";
  if (text.includes("imlil") || text.includes("ouirgane") || text.includes("valley")) return "Valley tracks, village routes and assisted climbs";
  if (text.includes("private")) return "Private, tailored electric mountain biking";
  return "Electric mountain biking across mountain tracks and valleys";
}

function getTerrainNotes(tour: EbikeTrip) {
  const text = `${tour.title} ${tour.label} ${tour.region}`.toLowerCase();
  const base = "Battery range depends on battery capacity, elevation, terrain, assistance setting, rider and bike weight, temperature and riding style. The plan should identify where charging is possible and whether a charger or spare battery is needed.";
  if (text.includes("desert") || text.includes("south morocco") || text.includes("agafay")) return `Open and remote terrain can mean more sun exposure, loose stones and longer gaps between services. ${base} Water, support and conservative range planning are essential.`;
  if (text.includes("coast") || text.includes("atlantic")) return `The route may cross several regions, with wind and transfer distances affecting effort. ${base} Overnight charging locations and any transport-only stages should be confirmed.`;
  if (text.includes("imlil") || text.includes("ouirgane") || text.includes("valley") || text.includes("atlas")) return `Atlas terrain can vary between rural tracks, rocky paths, village lanes, sustained climbs and narrower trails. ${base} Current access, weather and handling confidence influence route choice.`;
  if (text.includes("family")) return `Surfaces, gradients and route length should be suitable for every rider in the family. ${base} Confirm bike fit, safe assistance settings and break locations before departure.`;
  return `The exact surface and climbing depend on the agreed route. ${base} Confirm practical support and technical difficulty with the guide before travelling.`;
}

function getBestFor(tour: EbikeTrip, content: TourContent) {
  const text = `${tour.title} ${tour.label}`.toLowerCase();
  if (text.includes("family")) return "Families whose riders all have suitable bike control and can follow the guide’s route and safety instructions.";
  if (text.includes("luxury")) return "Riders who want electric-assisted riding combined with carefully planned accommodation and logistics.";
  if (text.includes("private")) return "Friends, couples or groups who want dates, route, pace and support planned specifically for them.";
  if (text.includes("desert") || text.includes("south morocco") || text.includes("agafay")) return "Riders comfortable preparing for exposed terrain, heat and more deliberate water and battery planning.";
  if (text.includes("day tours")) return "Visitors who want a guided electric mountain bike ride near Marrakech, matched to their available time and confidence.";
  return `Riders whose fitness and handling skills match a ${content.difficulty.toLowerCase()} route, with battery range and charging planned before travel.`;
}

function makeDayDescription(tour: EbikeTrip, stage: string, index: number, total: number) {
  const lower = stage.toLowerCase();
  if (lower.includes("arrival") || lower.includes("meet") || lower.includes("setup") || lower.includes("preparation") || lower.includes("briefing") || lower.includes("bike fitting")) {
    return `Meet the team, fit the bike and review assistance modes, battery range and the route plan. Confirm charger, spare battery and support arrangements for ${tour.title} before setting off.`;
  }
  if (lower.includes("transfer") || lower.includes("departure") || lower.includes("onward travel") || lower.includes("wrap-up")) {
    return `Allow time for the planned transfer or departure arrangements. Whether riding is included depends on travel schedules; confirm the finish point, battery and bike transport, luggage and timings in advance.`;
  }
  if (lower.includes("recovery") || lower.includes("flexible") || lower.includes("rest")) {
    return `Keep this stage flexible for recovery, local conditions, charging or a shorter optional ride. Confirm with the team whether it is a riding, rest or transfer day in the final itinerary.`;
  }
  if (lower.includes("desert") || lower.includes("southern") || lower.includes("remote") || lower.includes("open-country") || lower.includes("agafay")) {
    return `Explore the planned routes through ${tour.region}. Distance, surface, water stops, battery use and vehicle support should be checked for the season; avoid assuming charging will be available along the route.`;
  }
  if (lower.includes("valley") || lower.includes("village") || lower.includes("mountain") || lower.includes("atlas") || lower.includes("coast")) {
    return `Ride a route selected for the group through ${tour.region}, with time for climbs, descents and planned stops. The guide should confirm distance, elevation, charging windows and support based on local access and current conditions.`;
  }
  if (index === total - 1) return `Complete the final planned ride or wrap up the journey, depending on departure times and conditions. Confirm the finish point, battery charging, bike transport and onward travel before the trip begins.`;
  return `Explore a stage planned around ${tour.region}, the group’s fitness and the intended E-MTB riding style. Daily distance, elevation, battery use, charging, stops and support arrangements should be confirmed in the final itinerary.`;
}

function makeFaqs(tour: EbikeTrip, content: TourContent) {
  return [
    {
      question: `How far can I ride on an E-MTB battery during the ${tour.title}?`,
      answer: `Range depends on battery capacity, elevation, terrain, assistance mode, temperature and rider/bike weight. The route and charging plan should be checked together, and a charger or spare battery discussed where needed. No fixed range is guaranteed for every rider.`,
    },
    {
      question: `How difficult is this ${tour.duration} E-MTB tour?`,
      answer: `${content.difficulty}. ${content.difficultyDescription} Electric assistance helps with pedalling effort but does not replace bike control, braking skill or route awareness.`,
    },
    {
      question: `Can I bring my own electric mountain bike?`,
      answer: `Ask about using your own bike when enquiring. The practical details depend on its condition, battery and charger, transport arrangements and whether support or a rental option is available. Tell us your model and any charging needs before the trip is confirmed.`,
    },
    {
      question: `Can the route be adjusted for our group?`,
      answer: `The route, daily distance, climbing and technical sections can be discussed around your dates and experience. The written proposal should confirm bike arrangements, charging opportunities, transfers, accommodation and which services are included.`,
    },
  ];
}

